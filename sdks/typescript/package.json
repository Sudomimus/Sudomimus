{
    "name": "@sudomimus/sdks-typescript",
    "private": true,
    "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
    "scripts": {
        "iud": "node scripts/maintenance/dependencies/maintenance.ts iud",
        "update-dependencies": "node scripts/maintenance/dependencies/maintenance.ts update-dependencies",
        "generate": "turbo run generate",
        "compile": "turbo run compile",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "coverage": "turbo run coverage",
        "publish:connect": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/connect pnpm release:publish",
        "publish-dry-run:connect": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/connect pnpm release:dry-run",
        "publish:device": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/device pnpm release:publish",
        "publish-dry-run:device": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/device pnpm release:dry-run",
        "publish:native": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/native pnpm release:publish",
        "publish-dry-run:native": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/native pnpm release:dry-run",
        "publish:nextjs": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/nextjs pnpm release:publish",
        "publish-dry-run:nextjs": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/nextjs pnpm release:dry-run",
        "publish:nuxt": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/nuxt pnpm release:publish",
        "publish-dry-run:nuxt": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/nuxt pnpm release:dry-run",
        "publish:react-router": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/react-router pnpm release:publish",
        "publish-dry-run:react-router": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/react-router pnpm release:dry-run",
        "publish:session": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/session pnpm release:publish",
        "publish-dry-run:session": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/session pnpm release:dry-run",
        "publish:token": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/token pnpm release:publish",
        "publish-dry-run:token": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/token pnpm release:dry-run",
        "publish:web": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/web pnpm release:publish",
        "publish-dry-run:web": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/web pnpm release:dry-run",
        "depcheck": "node scripts/maintenance/dependencies/maintenance.ts depcheck",
        "update-actions": "node scripts/maintenance/dependencies/maintenance.ts update-actions",
        "update-all": "node scripts/maintenance/dependencies/maintenance.ts update-all",
        "update-self": "node scripts/maintenance/dependencies/maintenance.ts update-self",
        "ud": "node scripts/maintenance/dependencies/maintenance.ts ud",
        "sort-dependencies": "node scripts/maintenance/dependencies/maintenance.ts sort-dependencies",
        "sort-workspace": "node scripts/maintenance/dependencies/maintenance.ts sort-workspace",
        "sort-all": "node scripts/maintenance/dependencies/maintenance.ts sort-all",
        "changeset": "node scripts/release/versioning/version.ts add",
        "version:dry-run": "node scripts/release/versioning/version.ts plan",
        "version:packages": "node scripts/release/versioning/version.ts apply",
        "release:prepare": "pnpm compile",
        "release:publish": "node scripts/release/publishing/publish.ts",
        "release:dry-run": "node scripts/release/publishing/publish.ts --dry-run",
        "release:initial": "node scripts/release/publishing/initial-publish.ts",
        "release:pack": "node scripts/release/packing/pack.ts",
        "check:workflows": "node scripts/validation/workflows.ts",
        "test:tooling": "node --test scripts/test/*.test.ts",
        "validate": "pnpm version:dry-run && pnpm check:workflows && pnpm typecheck:tooling && pnpm test:tooling && pnpm lint && pnpm compile && pnpm test",
        "typecheck:tooling": "tsc -p scripts/tsconfig.json"
    },
    "devDependencies": {
        "@types/jest": "catalog:",
        "@types/node": "catalog:",
        "@typescript-eslint/eslint-plugin": "catalog:",
        "@typescript-eslint/parser": "catalog:",
        "eslint": "catalog:",
        "jest": "catalog:",
        "openapi-typescript": "catalog:",
        "ts-jest": "catalog:",
        "turbo": "catalog:",
        "typescript": "catalog:",
        "yaml": "catalog:",
        "@inquirer/checkbox": "catalog:"
    }
}
