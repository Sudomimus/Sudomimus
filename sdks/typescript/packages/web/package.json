{
    "name": "@sudomimus/web",
    "version": "0.2.0",
    "description": "Server-side Sudomimus Connect web login and session core",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Sudomimus/Sudomimus.git",
        "directory": "sdks/typescript/packages/web"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "compile": "tsc --project typescript/tsconfig.compile.json",
        "lint": "eslint src",
        "test": "jest",
        "release": "pnpm lint && pnpm test && pnpm compile",
        "release:dry-run": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/web pnpm -C ../.. release:dry-run",
        "release:publish": "SUDOMIMUS_TS_PUBLISH_TARGET=@sudomimus/web pnpm -C ../.. release:publish"
    },
    "dependencies": {
        "@sudomimus/connect": "workspace:*",
        "@sudomimus/session": "workspace:*"
    },
    "devDependencies": {
        "@types/jest": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "jest": "catalog:",
        "ts-jest": "catalog:",
        "typescript": "catalog:"
    }
}
