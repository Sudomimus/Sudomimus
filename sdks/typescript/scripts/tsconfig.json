{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "allowJs": true,
        "allowImportingTsExtensions": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "**/*.ts"
    ]
}
